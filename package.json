{
  "name": "band10-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source-first Xiaomi Smart Band 10 watch-face toolkit",
  "workspaces": [
    "preview"
  ],
  "scripts": {
    "band10": "tsx cli/index.ts",
    "assets": "tsx cli/index.ts assets own/minimal-amoled",
    "build": "tsx cli/index.ts build own/minimal-amoled",
    "inspect": "tsx cli/index.ts inspect own/minimal-amoled/dist/carbon-signal.face",
    "lint": "npm --prefix preview run lint",
    "package": "tsx cli/index.ts package own/minimal-amoled",
    "preview": "tsx cli/index.ts preview own/minimal-amoled",
    "validate": "tsx cli/index.ts validate own/minimal-amoled"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "nepali-date-converter": "^3.4.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.13",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
