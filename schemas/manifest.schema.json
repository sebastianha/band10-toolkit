{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://band10-toolkit.dev/schemas/manifest.schema.json",
  "title": "Band 10 Toolkit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "id",
    "name",
    "author",
    "version",
    "device",
    "preview",
    "output",
    "compiler"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{9}$",
      "description": "Nine-byte ASCII ID stored at binary offset 0x28."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "author": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "license": { "type": "string" },
    "device": { "const": "xiaomi-smart-band-10" },
    "preview": {
      "type": "string",
      "minLength": 1,
      "description": "Use generated for a deterministic renderer screenshot, or a relative image path."
    },
    "output": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "imageCompression"],
      "properties": {
        "target": { "enum": ["native", "mi-create", "mi8-tool"] },
        "imageCompression": { "type": "boolean" }
      }
    }
  }
}